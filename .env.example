# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Clé secrète Stripe (sk_test_... ou sk_live_...)
# Indispensable pour créer des sessions de paiement sécurisées Stripe Checkout.
# Ajoutez cette variable dans le panneau "Secrets" de Google AI Studio.
STRIPE_SECRET_KEY="sk_test_..."

# STRIPE_PUBLISHABLE_KEY: Clé publique Stripe (pk_test_... ou pk_live_...)
# Utilisée côté client si nécessaire.
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# STRIPE_WEBHOOK_SECRET: Clé secrète de signature des webhooks Stripe (whsec_...)
# Permet de valider cryptographiquement les événements envoyés par Stripe.
STRIPE_WEBHOOK_SECRET="whsec_..."

# STRIPE_PRICE_ID_MONTHLY: ID du tarif mensuel Stripe (ex: price_123) [Optionnel]
# Si absent, le tarif 4,99 €/mois est créé dynamiquement par l'API.
STRIPE_PRICE_ID_MONTHLY="price_..."

# STRIPE_PRICE_ID_YEARLY: ID du tarif annuel Stripe (ex: price_456) [Optionnel]
# Si absent, le tarif 39,99 €/an est créé dynamiquement par l'API.
STRIPE_PRICE_ID_YEARLY="price_..."
