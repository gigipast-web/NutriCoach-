[{id:"r1",title:"Bowl Méditerranéen Poulet & Avocat",description:"Un repas complet, gourmand et équilibré riche en protéines et bonnes graisses.",prepTimeMinutes:15,calories:420,protein:36,carbs:35,fat:14,category:"riches_proteines",imageUrl:"https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80",ingredients:["120g de blanc de poulet grillé","80g de quinoa cuit","1/2 avocat mûr en tranché","50g de concombres et tomates cerises","1 c.à.s de sauce yaourt aux fines herbes et citron"],instructions:["Faire cuire le quinoa et laisser tiédir.","Saisir le blanc de poulet avec un filet d'huile d'olive et des herbes de Provence.","Dresser le quinoa dans un bol, ajouter le poulet, l'avocat et les crudités.","Napper de la sauce yaourt légère au citron."],tags:["Riche en Protéines","Sans Gluten","Express"]},{id:"r2",title:"Wok de Cabillaud & Légumes Croquants",description:"Une recette ultra-légère et rassasiante aux saveurs gingembre-soja.",prepTimeMinutes:20,calories:290,protein:32,carbs:18,fat:6,category:"faibles_calories",imageUrl:"https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=800&q=80",ingredients:["150g de dos de cabillaud","100g de courgettes et carottes coupées en julienne","50g de pousses de soja","1 c.à.s de sauce soja salée pauvre en sodium","Gingembre frais râpé et ciboulette"],instructions:["Casseroles légumes dans un wok très chaud pendant 5 min avec un filet d'eau.","Ajouter le cabillaud coupé en gros dés.","Verser la sauce soja et le gingembre râpé.","Laisser mijoter 6 à 8 minutes à feu doux."],tags:["Faible Calorie","Sans Gluten","Protéiné"]},{id:"r3",title:"Curry Doux de Lentilles Coral & Épinards",description:"Plat végétarien réconfortant et très riche en fibres et minéraux.",prepTimeMinutes:25,calories:360,protein:18,carbs:48,fat:9,category:"vegetarienne",imageUrl:"https://images.unsplash.com/photo-1543339308-43e59d6b73a6?auto=format&fit=crop&w=800&q=80",ingredients:["70g de lentilles corail crues","100ml de lait de coco léger","50g d'épinards frais","1/2 oignon et 1 gousse d'ail","1 c.à.c de curry doux"],instructions:["Faire revenir l'oignon haché et l'ail.","Ajouter le curry et les lentilles rincées.","Verser 200ml d'eau et le lait de coco.","Cuire 15 minutes à petit bouillon, incorporent les épinards en fin de cuisson."],tags:["Végétarien","Riche en Fibres","Sans Gluten"]},{id:"r4",title:"Omelette Soufflée aux Épinards & Féta 0%",description:"Le petit-déjeuner ou dîner express parfait pour faire le plein de légèreté.",prepTimeMinutes:10,calories:240,protein:21,carbs:6,fat:14,category:"express",imageUrl:"https://images.unsplash.com/photo-1525351484163-7529414344d8?auto=format&fit=crop&w=800&q=80",ingredients:["2 œufs frais bio","40g d'épinards frais tombés à la poêle","30g de féta allégée","Poivre noir et ciboulette fraîche"],instructions:["Battre les œufs vigoureusement pour incorporer de l'air.","Faire fondre les épinards dans une poêle antiadhésive.","Verser les œufs battus, émietter la féta au centre.","Replier l'omelette et servir immédiatement."],tags:["Express 10 min","Low Carb","Végétarien"]}],yb=[{id:"b1",title:"Premier Pas",description:"Enregistrer votre première pesée sur l'application.",iconName:"Scale",unlocked:!0,unlockedDate:"2026-06-01",progress:1,maxProgress:1,category:"pesee"},{id:"b2",title:"Champion Hydratation",description:"Atteindre votre objectif de 8 verres d'eau par jour.",iconName:"Droplets",unlocked:!0,unlockedDate:"2026-08-01",progress:8,maxProgress:8,category:"hydratation"},{id:"b3",title:"Série de 5 Jours 🔥",description:"Remplir votre journal alimentaire pendant 5 jours consécutifs.",iconName:"Flame",unlocked:!0,unlockedDate:"2026-08-01",progress:5,maxProgress:5,category:"serie"},{id:"b4",title:"Marcheur Régulier",description:"Franchir le cap des 10 000 pas en une seule journée.",iconName:"Footprints",unlocked:!1,progress:6842,maxProgress:1e4,category:"pas"},{id:"b5",title:"Cap des -5 kg 🎯",description:"Perdre 5 kilogrammes depuis votre poids de départ.",iconName:"Trophy",unlocked:!0,unlockedDate:"2026-07-20",progress:5.7,maxProgress:5,category:"pesee"},{id:"b6",title:"Gourmet Équilibré",description:"Ajouter 10 recettes favorites à votre menu.",iconName:"UtensilsCrossed",unlocked:!1,progress:4,maxProgress:10,category:"repas"}],jb=[{id:"r1",title:"Boire un verre d'eau 💧",subtitle:"Pensez à bien vous hydrater régulièrement",type:"eau",time:"10:30",enabled:!0},{id:"r2",title:"Enregistrer le Déjeuner 🍽️",subtitle:"Notez votre repas pour suivre vos calories",type:"repas",time:"13:00",enabled:!0},{id:"r3",title:"Pause Marche Active 🚶",subtitle:"Objectif 10 000 pas : bougez quelques minutes !",type:"marche",time:"17:30",enabled:!0},{id:"r4",title:"Pesée Hebdomadaire ⚖️",subtitle:"Suivez la tendance de votre poids le dimanche",type:"pesee",time:"08:00",enabled:!0}],I0=[{text:"Chaque repas est une opportunité de nourrir votre corps avec amour.",author:"NutriCoach"},{text:"La constance bat la perfection. Continuez un jour à la fois !",author:"Conseil Minceur"},{text:"Le succès est la somme de petits efforts répétés jour après jour.",author:"Robert Collier"},{text:"L'eau est le carburant le plus pur de votre métabolisme.",author:"Équilibre Santé"}],Nb=({badges:g,reminders:D,onToggleReminder:E,streakDays:f,isDarkMode:M})=>{const[C,Y]