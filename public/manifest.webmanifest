{
  "id": "/",
  "name": "NutriCoach Minceur - Coach Nutrition & Perte de Poids",
  "short_name": "NutriCoach",
  "description": "NutriCoach Minceur : Application mobile d'accompagnement minceur personnalisé : journal alimentaire, scanner photo IA, suivi du poids, recettes équilibrées sans gluten, hydratation et coach vocal IA.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "lang": "fr-FR",
  "dir": "ltr",
  "background_color": "#F8FAF8",
  "theme_color": "#10B981",
  "categories": ["health", "fitness", "lifestyle", "food"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "handle_links": "preferred",
  "capture_links": "existing-client-navigate",
  "scope_extensions": [
    {
      "origin": "https://nutricoach.netlify.app"
    }
  ],
  "url_handlers": [
    {
      "origin": "https://nutricoach.netlify.app"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+nutricoach",
      "url": "/?protocol_action=%s",
      "title": "Ouvrir dans NutriCoach Minceur"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.nutricoach.nutrition.coach",
      "id": "com.nutricoach.nutrition.coach"
    },
    {
      "platform": "windows",
      "url": "https://www.microsoft.com/store/apps/LESCAPADEDEJOS.NutriCoach-SuiviMinceur",
      "id": "LESCAPADEDEJOS.NutriCoach-SuiviMinceur"
    }
  ],
  "share_target": {
    "action": "/?action=share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/?action=scan",
      "accept": {
        "image/*": [".jpg", ".jpeg", ".png", ".webp"]
      }
    }
  ],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Écran d'accueil et suivi des calories NutriCoach"
    },
    {
      "src": "/screenshots/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tableau de bord complet sur ordinateur et tablette"
    }
  ],
  "shortcuts": [
    {
      "name": "Journal Alimentaire",
      "short_name": "Journal",
      "description": "Ajouter un repas au journal",
      "url": "/?tab=journal",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Coach Nutritionnel IA",
      "short_name": "Coach IA",
      "description": "Poser une question au coach IA",
      "url": "/?tab=aicoach",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Hydratation",
      "short_name": "Eau",
      "description": "Ajouter un verre d'eau",
      "url": "/?tab=hydration",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Recettes Équilibrées",
      "short_name": "Recettes",
      "description": "Découvrir des idées repas saines",
      "url": "/?tab=recipes",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    }
  ]
}
